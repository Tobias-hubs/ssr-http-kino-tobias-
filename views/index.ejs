<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Movie List</title>
</head>
<body>
  <h1>Movie List</h1>
  <ul>
    <% movies.forEach(movie => { %>
      <li>
        <a href="/movie/<%= movie.id %>">
          <h2><%= movie.attributes.title %></h2>
        </a>
      </li>
    <% }) %>
  </ul>
  
</body>
</html>

